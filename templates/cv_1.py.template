# cv_1.py — mass-weighted radius of gyration of CA atoms. No reference needed.
#
# See cv_0.py.template for the interface contract.
import numpy as np

def compute(u, ref):  # ref is unused for Rg
    ca = u.select_atoms("name CA")
    coords = ca.positions
    masses = ca.masses
    com = np.average(coords, axis=0, weights=masses)
    sq = np.sum((coords - com) ** 2, axis=1)
    return float(np.sqrt(np.average(sq, weights=masses)))
