#!/bin/bash
# Per-run environment for ParGaMD. Materialized by new_run.sh into the run
# dir; safe to edit by hand afterwards.

# ---------------------------------------------------------------------------
# Conda
# ---------------------------------------------------------------------------
source ~/.bashrc 2>/dev/null || true
if ! command -v conda >/dev/null || ! type conda 2>/dev/null | grep -q function; then
    for h in "$HOME/miniconda3/etc/profile.d/conda.sh" \
             "$HOME/anaconda3/etc/profile.d/conda.sh" \
             "/opt/conda/etc/profile.d/conda.sh"; do
        [ -f "$h" ] && source "$h" && break
    done
fi
conda activate pargamd

# ---------------------------------------------------------------------------
# Layout
# ---------------------------------------------------------------------------
# WEST_SIM_ROOT is the run dir (this dir). run_local.sh sets it to its own
# location if unset; we mirror that fallback here for direct sourcing.
if [[ -z "${WEST_SIM_ROOT:-}" ]]; then
    export WEST_SIM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
export SIM_NAME=$(basename "$WEST_SIM_ROOT")
echo "simulation $SIM_NAME root is $WEST_SIM_ROOT"

# Code dirs — symlinks to the pargamd repo, materialized by new_run.sh.
# runseg.sh, get_pcoord.sh, bench/run_bench.sh, run_local.sh all read these.
export PARGAMD_RUNTIME_DIR="$WEST_SIM_ROOT/runtime"
export PARGAMD_SYSTEM_DIR="$WEST_SIM_ROOT/system"

# ---------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------
# Set by new_run.sh; runseg.sh symlinks $PARGAMD_SYSTEM_DIR/$SYSTEM_NAME.{parm7,rst7}
# into the seg dir as topology.parm7 / coordinates.rst7. To swap systems
# entirely, scaffold a new run dir with new_run.sh --system <other>.
export SYSTEM_NAME="__SYSTEM_NAME__"

# ---------------------------------------------------------------------------
# Trajectory stripping (post-iteration disk-space management)
# ---------------------------------------------------------------------------
# ON BY DEFAULT. When set to 1, post_iter.sh fires westpa_scripts/strip_iter.sh in the
# background after each iteration to remove solvent atoms from completed
# iterations' output_restart.dcd files.
#
# Default changed from 0 to 1: a solvated nucleoprotein run writes ~250 MB of
# solvent per segment that nothing downstream reads, and two runs scaffolded
# with the old default accumulated 1.3 TB of recoverable solvent before anyone
# noticed. Set STRIP_AFTER_ITERS=0 in the environment to opt out.
#
# Stripping always lags by 2 iterations so the freeze-fallback in
# runseg.sh (which reads iter N-1's full-atom DCD when iter N has all
# retries fail) stays correct. When your production run is truly done,
# run ./westpa_scripts/strip_iter.sh --finalize from the run dir to
# strip the held-back final iters too.
#
# STRIP_MASK is a cpptraj atom-mask string identifying what to REMOVE.
# Defaults strip water + standard counterions, keeping divalents like
# Mg2+ / Zn2+ / Ca2+ that are often catalytically essential.
# ---------------------------------------------------------------------------
# Trajectory storage
# ---------------------------------------------------------------------------
# traj_segs holds every segment's DCD and checkpoint and is by far the largest
# thing a run produces -- hundreds of GB for a solvated system over a few dozen
# iterations. It must NOT live on the boot drive.
#
# If PARGAMD_SCRATCH_ROOT exists and is writable, new_run.sh creates
#   $PARGAMD_SCRATCH_ROOT/<run name>/traj_segs
# and symlinks it in as <run dir>/traj_segs, and init.sh preserves that symlink
# across re-initialisation. Otherwise traj_segs is a plain local directory and
# everything behaves as before, which is what you want on a cluster that hands
# you scratch through a different path.
export PARGAMD_SCRATCH_ROOT="${PARGAMD_SCRATCH_ROOT:-/scratch/pool}"

# Solvent stripping -- ON BY DEFAULT.
#
# With STRIP_AFTER_ITERS=1, post_iter.sh fires westpa_scripts/strip_iter.sh in
# the background after each iteration and removes solvent from iteration N-2's
# output_restart.dcd files. The lag keeps runseg.sh's freeze-fallback safe,
# which reads iteration N-1 in full.
#
# The default was 0 and is now 1. A solvated nucleoprotein segment writes
# ~250 MB of solvent that nothing downstream reads -- no CV here touches water,
# and the full solvated state needed to restart a walker lives in its
# gamd_restart.checkpoint, which stripping never touches. Two runs scaffolded
# with the old default accumulated ~1.3 TB of recoverable solvent before it was
# noticed, and only ran at all because the runs that DID strip had the variable
# set by hand rather than from this template.
#
# Set STRIP_AFTER_ITERS=0 in the environment to opt out. When a run is finished,
# `westpa_scripts/strip_iter.sh --finalize` recovers the held-back last
# iterations too.
#
# STRIP_MASK is a cpptraj mask naming what to REMOVE. The default keeps
# catalytic divalents (Mg2+, Zn2+, Ca2+), which are often essential.
export STRIP_AFTER_ITERS="${STRIP_AFTER_ITERS:-1}"
export STRIP_MASK="${STRIP_MASK:-:WAT,Na+,Cl-,K+}"

# ---------------------------------------------------------------------------
# ZMQ / WESTPA tuning
# ---------------------------------------------------------------------------
export USE_LOCAL_SCRATCH=1
export WM_ZMQ_MASTER_HEARTBEAT=100
export WM_ZMQ_WORKER_HEARTBEAT=100
export WM_ZMQ_TIMEOUT_FACTOR=300
