#!/bin/bash
# Per-run environment for ParGaMD. Materialized by new_run.sh into the run
# dir; safe to edit by hand afterwards.

# ---------------------------------------------------------------------------
# Conda
# ---------------------------------------------------------------------------
source ~/.bashrc 2>/dev/null || true
if ! command -v conda >/dev/null || ! type conda 2>/dev/null | grep -q function; then
    for h in "$HOME/miniconda3/etc/profile.d/conda.sh" \
             "$HOME/anaconda3/etc/profile.d/conda.sh" \
             "/opt/conda/etc/profile.d/conda.sh"; do
        [ -f "$h" ] && source "$h" && break
    done
fi
conda activate pargamd

# ---------------------------------------------------------------------------
# Layout
# ---------------------------------------------------------------------------
# WEST_SIM_ROOT is the run dir (this dir). run_local.sh sets it to its own
# location if unset; we mirror that fallback here for direct sourcing.
if [[ -z "${WEST_SIM_ROOT:-}" ]]; then
    export WEST_SIM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
export SIM_NAME=$(basename "$WEST_SIM_ROOT")
echo "simulation $SIM_NAME root is $WEST_SIM_ROOT"

# Code dirs — symlinks to the pargamd repo, materialized by new_run.sh.
# runseg.sh, get_pcoord.sh, bench/run_bench.sh, run_local.sh all read these.
export PARGAMD_RUNTIME_DIR="$WEST_SIM_ROOT/runtime"
export PARGAMD_SYSTEM_DIR="$WEST_SIM_ROOT/system"

# ---------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------
# Set by new_run.sh; runseg.sh symlinks $PARGAMD_SYSTEM_DIR/$SYSTEM_NAME.{parm7,rst7}
# into the seg dir as topology.parm7 / coordinates.rst7. To swap systems
# entirely, scaffold a new run dir with new_run.sh --system <other>.
export SYSTEM_NAME="__SYSTEM_NAME__"

# ---------------------------------------------------------------------------
# ZMQ / WESTPA tuning
# ---------------------------------------------------------------------------
export USE_LOCAL_SCRATCH=1
export WM_ZMQ_MASTER_HEARTBEAT=100
export WM_ZMQ_WORKER_HEARTBEAT=100
export WM_ZMQ_TIMEOUT_FACTOR=300
