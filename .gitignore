# WESTPA run outputs (regenerated each run)
west.h5
west.log
traj_segs/
seg_logs/
istates/
strip.log
board_health.log

# Logs
*.log

# Plots and other run artifacts
*.png

# ZMQ runtime — master publishes connection info for clients
west_zmq_info.json

# Python noise
__pycache__/
*.py[cod]
*$py.class

# Profiling artifacts
*.nsys-rep
*.sqlite

# Editor / OS
.DS_Store
*.swp
*~

# Per-system extras kept locally only
.pre_refactor_backup/
.claude/

# Phase 1 equilibration outputs (regenerated by equilibrate.sh, GPU-arch-specific)
# In a scaffolded run dir these appear at equilibration/out/; in the repo
# they're never created (the repo holds code only, no runs).
equilibration/out/
bench/run-*/

# Per-run artifacts that should never end up in the repo, even by accident.
# (None of these are created in the repo when used via new_run.sh, but
# someone running ./run_local.sh from a non-run-dir checkout could spawn
# them. Listing them keeps `git status` clean if that happens.)
/system/
/equilibration/
/bstates/
/west.cfg
/env.sh
/input.xml
/gamd_restart.checkpoint
/gamd-restart.dat
